CREATE DATABASE PagapocoDB;

USE PagapocoDB;

-- Users
CREATE TABLE [Users] (
    [Id] UNIQUEIDENTIFIER NOT NULL PRIMARY KEY,
    [Name] NVARCHAR(256) NULL,
    [Email] NVARCHAR(256) NOT NULL,
    [Phone] NVARCHAR(50) NULL,
    [City] NVARCHAR(100) NULL,
    [IsDeleted] BIT NOT NULL DEFAULT 0,
    [PasswordHash] NVARCHAR(512) NOT NULL,
    [PasswordSalt] NVARCHAR(512) NOT NULL
);

CREATE UNIQUE INDEX IX_Users_Email ON [Users]([Email]);

-- Publications (Base class)
CREATE TABLE [Publications] (
    [Id] UNIQUEIDENTIFIER NOT NULL PRIMARY KEY,
    [Title] NVARCHAR(256) NOT NULL,
    [Description] NVARCHAR(MAX) NOT NULL,
    [Price] DECIMAL(18,2) NOT NULL,
    [City] NVARCHAR(100) NOT NULL,
    [IsPremium] BIT NOT NULL,
    [Type] NVARCHAR(100) NOT NULL,
    [IsPaused] BIT NOT NULL DEFAULT 0,
    [UserId] UNIQUEIDENTIFIER NOT NULL,
    [Brand] NVARCHAR(100) NOT NULL,
    [Model] NVARCHAR(100) NOT NULL,
    [Color] NVARCHAR(100) NOT NULL,
    [Condition] NVARCHAR(100) NOT NULL,
    [Compatibility] NVARCHAR(100) NOT NULL,
    CONSTRAINT FK_Publications_Users_UserId FOREIGN KEY ([UserId]) REFERENCES [Users]([Id]) ON DELETE CASCADE
);

-- Images
CREATE TABLE [Images] (
    [Id] UNIQUEIDENTIFIER NOT NULL PRIMARY KEY,
    [Url] NVARCHAR(512) NOT NULL,
    [AltText] NVARCHAR(256) NULL,
    [DisplayOrder] INT NULL,
    [PublicationId] UNIQUEIDENTIFIER NOT NULL,
    CONSTRAINT FK_Images_Publications_PublicationId FOREIGN KEY ([PublicationId]) REFERENCES [Publications]([Id]) ON DELETE CASCADE
);





