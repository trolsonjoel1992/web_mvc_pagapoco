CREATE DATABASE PagapocoDB;

USE PagapocoDB;

-- Users
CREATE TABLE User (
  Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
  [Name] NVARCHAR(100) NOT NULL,
  Email NVARCHAR(100) NOT NULL,
  Phone NVARCHAR(50) NOT NULL,
  City NVARCHAR(100) NOT NULL
);

-- Publications (Base class)
CREATE TABLE Publication (
  Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
  Title NVARCHAR(200) NOT NULL,
  [Description] NVARCHAR(MAX) NOT NULL,
  Price DECIMAL(18,2) NOT NULL,
  City NVARCHAR(100) NOT NULL,
  IsPremium BIT,
  Type NVARCHAR(50) NOT NULL, 
  UserId UNIQUEIDENTIFIER FOREIGN KEY REFERENCES User(Id)
);

-- Vehicles (Subclass)
CREATE TABLE Vehicle (
  Id UNIQUEIDENTIFIER PRIMARY KEY FOREIGN KEY REFERENCES Publication(Id),
  Brand NVARCHAR(100) NOT NULL,
  Model NVARCHAR(100) NOT NULL,
  [Year] INT NOT NULL,
  Color NVARCHAR(50) NOT NULL,
  FuelType NVARCHAR(50) NOT NULL,
  Transmission NVARCHAR(50) NOT NULL,
  EngineDisplacement NVARCHAR(50) NOT NULL,
  KilometersDriven INT NOT NULL,
  [Version] NVARCHAR(100) NOT NULL,
  Doors INT NOT NULL,
);

-- Bikes (Subclass)
CREATE TABLE Bike (
  Id UNIQUEIDENTIFIER PRIMARY KEY FOREIGN KEY REFERENCES Publication(Id),
  Brand NVARCHAR(100) NOT NULL,
  Model NVARCHAR(100) NOT NULL,
  [Year] INT NOT NULL,
  Color NVARCHAR(50) NOT NULL,
  FuelType NVARCHAR(50) NOT NULL,
  Transmission NVARCHAR(50) NOT NULL,
  EngineDisplacement NVARCHAR(50) NOT NULL,
  KilometersDriven INT NOT NULL,
  EnginePower INT NOT NULL,
  WheelSize NVARCHAR(4) NOT NULL
);

-- Parts (Subclass)
CREATE TABLE Part (
  Id UNIQUEIDENTIFIER PRIMARY KEY FOREIGN KEY REFERENCES Publication(Id),
  Brand NVARCHAR(100) NOT NULL,
  Model NVARCHAR(100) NOT NULL,
  Color NVARCHAR(50) NOT NULL,
  Condition NVARCHAR(50) NOT NULL,
  Compatibility NVARCHAR(200) NOT NULL
);

-- Images
CREATE TABLE Image (
  Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
  [Url] NVARCHAR(500) NOT NULL,
  PublicationId UNIQUEIDENTIFIER FOREIGN KEY REFERENCES Publication(Id)
);

-- Questions 
CREATE TABLE Question (
  Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
  [Name] NVARCHAR(100) NOT NULL,
  LastName NVARCHAR(100) NOT NULL,
  Phone NVARCHAR(50) NOT NULL,
  Content NVARCHAR(MAX),
  Date DATETIME DEFAULT GETDATE(),
  UserId UNIQUEIDENTIFIER FOREIGN KEY REFERENCES User(Id),
  PublicationId UNIQUEIDENTIFIER FOREIGN KEY REFERENCES Publication(Id)
);

-- Answers 
CREATE TABLE Answer (
    Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
    Message NVARCHAR(MAX) NOT NULL,
    CreatedAt DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    QuestionId UNIQUEIDENTIFIER NOT NULL,
    UserId UNIQUEIDENTIFIER NOT NULL,
    CONSTRAINT FK_Answer_Question FOREIGN KEY (QuestionId)
        REFERENCES Question(Id),
    CONSTRAINT FK_Answer_User FOREIGN KEY (UserId)
        REFERENCES User(Id)
);

-- Notifications 
CREATE TABLE Notification (
    Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
    Message NVARCHAR(MAX) NOT NULL,
    CreatedAt DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    IsRead BIT NOT NULL DEFAULT 0,
    Type NVARCHAR(50) NOT NULL,
    UserId UNIQUEIDENTIFIER NOT NULL,
    PublicationId UNIQUEIDENTIFIER NULL,
    QuestionId UNIQUEIDENTIFIER NULL,
    CONSTRAINT FK_Notification_User FOREIGN KEY (UserId)
        REFERENCES User(Id),
    CONSTRAINT FK_Notification_Publication FOREIGN KEY (PublicationId)
        REFERENCES Publication(Id),
    CONSTRAINT FK_Notification_Question FOREIGN KEY (QuestionId)
        REFERENCES Question(Id)
);