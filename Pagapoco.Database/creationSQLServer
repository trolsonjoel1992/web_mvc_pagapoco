CREATE DATABASE PagapocoDB;

USE PagapocoDB;

-- Users
CREATE TABLE User (
  Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
  [Name] NVARCHAR(100) NOT NULL,
  Email NVARCHAR(100) NOT NULL,
  Phone NVARCHAR(50) ,
  City NVARCHAR(100) 
);

-- Publications (Base class)
CREATE TABLE Publication (
  Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
  Title NVARCHAR(200) NOT NULL,
  [Description] NVARCHAR(MAX) NOT NULL,
  Price DECIMAL(18,2) NOT NULL,
  City NVARCHAR(100) NOT NULL,
  IsPremium BIT,
  Type NVARCHAR(50) NOT NULL, 
  UserId UNIQUEIDENTIFIER FOREIGN KEY REFERENCES User(Id)
);

-- Vehicles (Subclass)
CREATE TABLE Vehicle (
  Id UNIQUEIDENTIFIER PRIMARY KEY FOREIGN KEY REFERENCES Publication(Id),
  Brand NVARCHAR(100) NOT NULL,
  Model NVARCHAR(100) NOT NULL,
  [Year] INT NOT NULL,
  Color NVARCHAR(50) NOT NULL,
  FuelType NVARCHAR(50) NOT NULL,
  Transmission NVARCHAR(50) NOT NULL,
  EngineDisplacement NVARCHAR(50) NOT NULL,
  KilometersDriven INT NOT NULL,
  [Version] NVARCHAR(100) NOT NULL,
  Doors INT NOT NULL,
);

-- Bikes (Subclass)
CREATE TABLE Bike (
  Id UNIQUEIDENTIFIER PRIMARY KEY FOREIGN KEY REFERENCES Publication(Id),
  Brand NVARCHAR(100) NOT NULL,
  Model NVARCHAR(100) NOT NULL,
  [Year] INT NOT NULL,
  Color NVARCHAR(50) NOT NULL,
  FuelType NVARCHAR(50) NOT NULL,
  Transmission NVARCHAR(50) NOT NULL,
  EngineDisplacement NVARCHAR(50) NOT NULL,
  KilometersDriven INT NOT NULL,
  EnginePower INT NOT NULL,
  WheelSize NVARCHAR(4) NOT NULL
);

-- Parts (Subclass)
CREATE TABLE Part (
  Id UNIQUEIDENTIFIER PRIMARY KEY FOREIGN KEY REFERENCES Publication(Id),
  Brand NVARCHAR(100) NOT NULL,
  Model NVARCHAR(100) NOT NULL,
  Color NVARCHAR(50) NOT NULL,
  Condition NVARCHAR(50) NOT NULL,
  Compatibility NVARCHAR(200) NOT NULL
);

-- Images
CREATE TABLE Image (
  Id UNIQUEIDENTIFIER PRIMARY KEY DEFAULT NEWID(),
  [Url] NVARCHAR(500) NOT NULL,
  PublicationId UNIQUEIDENTIFIER FOREIGN KEY REFERENCES Publication(Id)
);

